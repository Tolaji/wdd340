<main class="container">
  <%- include('../partials/head') %>
  <%- include('../partials/navigation') %>

  <h1><%= title %></h1>
  <%- messages() %>

  <% if (flash && flash.notice) { %>
    <div class="alert notice-box">
      <p><%= flash.notice %></p>
    </div>
  <% } %>

    
  <!-- Account Update Form -->
  <h2>Account Update</h2>
  <div class="management-forms-container">
      <section>
        
        <form action="/account/update" method="post">
          <label for="account_firstname">First Name</label>
          <input 
            type="text" 
            id="account_firstname" 
            name="account_firstname" 
            value="<%= accountData.account_firstname || '' %>" 
            required 
          >

          <label for="account_lastname">Last Name</label>
          <input 
            type="text" 
            id="account_lastname" 
            name="account_lastname" 
            value="<%= accountData.account_lastname || '' %>" 
            required 
          >

          <label for="account_email">Email</label>
          <input 
            type="email" 
            id="account_email" 
            name="account_email" 
            value="<%= accountData.account_email || '' %>" 
            required 
          >

          <input type="hidden" name="account_id" value="<%= accountData.account_id %>">

          <button type="submit">Update Account</button>
        </form>
      </section>
  </div>
  

  <!-- Change Password Form -->
   <h2>Change Password</h2>
   <div class="management-forms-container">
      <section>
        
        <p class="password-guidance">
          Enter a new password to change your current one. Passwords must be at least 12 characters long and include at least 1 uppercase letter, 1 number, and 1 special character.
        </p>

        <form action="/account/update-password" method="post">
          <label for="account_password">New Password</label>
          <input 
            type="password" 
            id="account_password" 
            name="account_password" 
            pattern="^(?=.*\\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\\s).{12,}$" 
            title="Must be 12+ characters with 1 uppercase letter, 1 number, and 1 special character." 
            required 
          >

          <input type="hidden" name="account_id" value="<%= accountData.account_id %>">

          <button type="submit">Change Password</button>
        </form>
      </section>
  </div>
</main>
