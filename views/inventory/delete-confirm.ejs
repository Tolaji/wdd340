<main class="container">
  <%- include('../partials/head') %>
  <%- include('../partials/navigation') %>

  <h1>Delete Vehicle</h1>

  <p class="alert alert-danger">⚠️ Confirm Deletion - This action is permanent and cannot be undone.</p>

  <% if (Array.isArray(messages) && messages.length > 0) { %>
    <div class="notice">
      <% messages.forEach(msg => { %>
        <p><%= msg %></p>
      <% }) %>
    </div>
  <% } %>

  <form class="management-forms-container" id="deleteForm" action="/inv/delete" method="post">
    <label for="inv_make">Make</label>
    <input type="text" id="inv_make" name="inv_make" value="<%= itemData.inv_make %>" readonly />

    <label for="inv_model">Model</label>
    <input type="text" id="inv_model" name="inv_model" value="<%= itemData.inv_model %>" readonly />

    <label for="inv_year">Year</label>
    <input type="number" id="inv_year" name="inv_year" value="<%= itemData.inv_year %>" readonly />

    <label for="inv_price">Price</label>
    <input type="number" id="inv_price" name="inv_price" step="0.01" value="<%= itemData.inv_price %>" readonly />

    <input type="hidden" name="inv_id" value="<%= inv_id %>">

    <button type="submit" class="btn btn-danger">Delete Vehicle</button>
  </form>
</main>
